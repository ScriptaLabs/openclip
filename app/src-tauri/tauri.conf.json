{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClip",
  "version": "0.1.0",
  "identifier": "dev.openclip.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenClip",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#090a0c",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost http://asset.localhost; media-src 'self' data: blob: asset: https://asset.localhost http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "OpenClip",
    "shortDescription": "Automatic game clipping",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../assets/branding/watermark.mov": "assets/branding/watermark.mov",
      "../../dependencies/ffmpeg/ffmpeg.exe": "bin/ffmpeg.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh",
        "displayLanguageSelector": false,
        "startMenuFolder": "OpenClip",
        "compression": "lzma"
      }
    }
  },
  "mainBinaryName": "OpenClip",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4MzMwREM5NTczNkEwQkIKUldTN29EWlh5UTB6NkhJb2NRc3FBa2xsSmpGdkc2K0JMQ2JmV21pclNrMEtzS0VTbDNvT0I1SWgK",
      "endpoints": [
        "https://github.com/ScriptaLabs/openclip/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
