# Copy to .env for local use. The real values live in GitHub (Settings > Secrets and variables > Actions).
# See docs/releasing.md for what each one is and where it is used.

# Supabase realtime URL that running copies of OpenClip subscribe to (public: anon key only).
SUPABASE_SUBSCRIBE=
# Supabase key that can only INSERT into public.update. CI only; never ship it.
SUPABASE_WRITE_KEY=

# Backblaze B2 application key (CI uploads installers and latest.json with it).
BACKBLAZE_KEYID=
BACKBLAZE_APPKEY=
